# ┌─────────────────────────────────────────────────────────────────┐
# │  Merrick Configuration                                         │
# │                                                                 │
# │  Standalone (docker-compose.yml):                               │
# │    Honcho & mem0 run externally — set their URLs below.         │
# │    Use host.docker.internal to reach services on your host.     │
# │                                                                 │
# │  Full Stack (docker-compose-full.yml):                          │
# │    All services run in containers on merrick-net.               │
# │    Ignore the host.docker.internal defaults — internal names    │
# │    (honcho-api, mem0) will be used automatically.               │
# └─────────────────────────────────────────────────────────────────┘

# ── PostgreSQL (Merrick's own DB) ────────────────────────────────
MERRICK_DB_USER=postgres
MERRICK_DB_PASSWORD=changeme_use_a_real_password
MERRICK_DB_NAME=postgres

# ── Honcho ───────────────────────────────────────────────────────
# Standalone: point to your external Honcho instance
# Full stack: override to http://honcho-api:8000 (or leave default)
MERRICK_HONCHO_URL=http://host.docker.internal:8000
MERRICK_HONCHO_WORKSPACE=hermes
MERRICK_HONCHO_USER_PEER=ron

# ── mem0 ─────────────────────────────────────────────────────────
# Standalone: point to your external mem0 instance
# Full stack: override to http://mem0:8000 (or leave default)
MERRICK_MEM0_API_URL=http://host.docker.internal:8888
MERRICK_MEM0_EMAIL=you@example.com
MERRICK_MEM0_PASSWORD=changeme

# ── Sync settings ────────────────────────────────────────────────
MERRICK_SYNC_INTERVAL=300
MERRICK_SYNC_ENABLED=true
